rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      // Allow users with role 'admin' in the users collection OR the specific super-admin email
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        || (request.auth != null && request.auth.token.email == 'retey.ay@hotmail.com');
    }
    
    // Users collection - admins can read/write, users can read/write their own data
    match /users/{userId} {
      allow read, write: if isAdmin() || request.auth.uid == userId;
    }
    
    // Products collection - authenticated users can read/write
    match /products/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    
    // Shops collection - authenticated users can read/write
    match /shops/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    
    // Batches collection - authenticated users can read/write
    match /batches/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    
    // Collections (payments) collection - authenticated users can read/write
    match /collections/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    
    // Recipes collection - authenticated users can read/write
    match /recipes/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    
    // Purchases collection - authenticated users can read/write
    match /purchases/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Sales collection - authenticated users can read/write
    match /sales/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // Money collection - authenticated users can read/write
    match /money/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    
    // Reports collection - authenticated users can read/write
    match /reports/{docId} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
  }
}
